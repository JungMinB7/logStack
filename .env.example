# 로컬 개발용 환경변수 예시. 복사해서 .env로 사용:  cp .env.example .env
# docker compose로 실행할 때는 docker-compose.yml의 기본값이 사용된다.

# PostgreSQL 연결 문자열 (로컬: docker compose up -d db 이후)
DATABASE_URL=postgresql://app:app@localhost:5432/gamelogs

# ── 필수 (fail-closed) ──────────────────────────────────────
# 아래 3개 키는 필수다. 하나라도 없으면 서버가 부팅에 실패한다
# (src/common/env.validation.ts — 키 없이 인증이 무력화되는 것을 방지).
# INGEST_API_KEY와 ADMIN_API_KEY는 서로 달라야 한다 (동일하면 부팅 거부 — 역할 분리).

# 적재 API 키 (인스턴스별 키 — 과제 구현에서는 환경변수 주입, assumptions.md A-21)
INGEST_API_KEY=dev-ingest-key

# 위 키에 매핑된 인스턴스 ID — 배치 내 이벤트의 instance_id와 불일치 시 403 (design.md §5.4)
INGEST_INSTANCE_ID=0fab3f2e-1894-41cd-b915-f99440a3ff32

# 조회(운영자) API 키
ADMIN_API_KEY=dev-admin-key
# ────────────────────────────────────────────────────────────

# 적재 경로의 키 단위 요청 한도 (고정 1분 창, 초과 시 429 + Retry-After).
# 선택 — 미설정 시 기본 120 (과제 전송 제약 120회/분)
# RATE_LIMIT_PER_MINUTE=120

# 서버 포트
PORT=3000
