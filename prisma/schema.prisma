// prisma/schema.prisma
// design.md §7 저장 스키마를 그대로 옮긴 것. 변경 시 design.md와 같은 커밋에서 동기화할 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// game_events — 모든 원본 이벤트 (design.md §7.1)
//
// 설계 포인트:
// - eventId가 PK = 멱등성 키. createMany({ skipDuplicates: true })가
//   ON CONFLICT DO NOTHING으로 동작하는 근거가 이 PK다.
// - eventType을 Prisma enum이 아니라 String으로 둔 이유:
//   PG enum 타입은 새 이벤트 타입 추가 시 DB 마이그레이션이 필요하다.
//   "게임 업데이트로 이벤트가 추가되어도 적재 서버 배포 불필요" 원칙(design.md §8.1)에
//   맞춰 문자열로 저장하고, 허용 목록 검증은 애플리케이션(DTO) 계층에서 수행한다.
// - userId/characterId는 BigInt: DB는 BIGINT.
//   ⚠ Prisma가 JS BigInt로 반환하므로 API 응답 직전 Number/문자열 변환 필수 (AI_RULES 15)
// - occurredAt/receivedAt 분리: 지표는 occurredAt, 수신·장애 분석은 receivedAt (design.md §6.3)
// - Timestamptz(3): 명세가 ms 정밀도 ISO8601이므로 밀리초(3자리)까지 보존
// ─────────────────────────────────────────────────────────────
model GameEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(32)
  userId      BigInt   @map("user_id")
  characterId BigInt   @map("character_id")
  sessionId   String   @map("session_id") @db.VarChar(64)
  channelId   String   @map("channel_id") @db.VarChar(64)
  payload     Json     // JSONB — 타입별 상세를 원본 그대로 보존
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  // shop_purchase인 경우에만 파생 행이 존재 (1:0..1)
  purchase Purchase?

  // (event_type, occurred_at): DAU·참여율 등 "타입+기간" 집계용
  @@index([eventType, occurredAt], map: "idx_events_type_time")
  // (user_id, occurred_at): 유저 최초 접속일(리텐션 코호트) 산출용
  @@index([userId, occurredAt], map: "idx_events_user_time")
  @@map("game_events")
}

// ─────────────────────────────────────────────────────────────
// purchases — 결제 파생 테이블 (design.md §7.2)
//
// 설계 포인트:
// - 적재 트랜잭션 안에서 game_events와 함께 기록 (Service→Repository에서 $transaction)
// - orderId UNIQUE: event_id(전송 멱등성 키)와 별개의 "업무 키".
//   같은 주문이 버그로 다른 event_id로 재전송돼도 매출 중복을 이중 방어 (design.md §6.2)
// - amountMinor BigInt: 최소 화폐 단위 정수. 부동소수점 저장 금지 (AI_RULES 4)
//   ⚠ 역시 JSON 직렬화 전 문자열 변환 필요 — API 응답의 revenue_minor가 문자열인 이유
// - currency Char(3): ISO 4217. 통화 간 합산 금지는 쿼리 계층에서 보장
// ─────────────────────────────────────────────────────────────
model Purchase {
  eventId     String   @id @map("event_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.VarChar(64)
  userId      BigInt   @map("user_id")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  productId   String   @map("product_id") @db.VarChar(64)
  productName String   @map("product_name") @db.VarChar(128)
  quantity    Int
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)

  // 원본 이벤트와 연결. 원본 삭제 시 파생도 함께 삭제
  event GameEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  // (occurred_at, currency): 기간·통화별 매출 집계용
  @@index([occurredAt, currency], map: "idx_purchases_time_currency")
  // (user_id, occurred_at): 결제 유저 수(PU)·전환율 집계용
  @@index([userId, occurredAt], map: "idx_purchases_user_time")
  @@map("purchases")
}
